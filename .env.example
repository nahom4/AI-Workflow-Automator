# Auth — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=

# Google OAuth — create at console.cloud.google.com → APIs & Services → Credentials
# Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
GROQ_API_KEY=gsk_...
GROQ_API_KEYS=           # comma-separated for multi-key rotation
GROQ_MODEL=llama-3.3-70b-versatile

# Notifications
RESEND_API_KEY=re_...
RESEND_FROM=noreply@yourdomain.com

# Database (leave blank to use ./data/automations.db locally)
DATABASE_PATH=

# Vercel / Turso (production only)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Worker
CHROME_HEADLESS=false
CHROME_STEALTH=true

# App URL — used as the return-URL origin for Paddle checkout
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paddle billing
# 1. Create a Paddle account at https://paddle.com (sandbox: https://sandbox-vendors.paddle.com)
# 2. In the dashboard: Catalog → Create a product "Pro" with two prices
#    - Monthly: $29 → copy the Price ID into PADDLE_PRICE_ID_PRO_MONTHLY
#    - Annual:  $276 ($23/mo) → copy into PADDLE_PRICE_ID_PRO_ANNUAL
# 3. Developer Tools → Authentication → create an API key → PADDLE_API_KEY
# 4. Developer Tools → Notifications → add an endpoint at /api/billing/webhook
#    Subscribe to: subscription.created, subscription.updated, subscription.canceled,
#                  subscription.activated, subscription.paused, transaction.completed
#    Copy the signing secret into PADDLE_WEBHOOK_SECRET
PADDLE_ENV=sandbox          # or "production"
PADDLE_API_KEY=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_ANNUAL=
PADDLE_WEBHOOK_SECRET=

# Coinbase Commerce (crypto payments — free, no platform fee)
# 1. Create an account at https://commerce.coinbase.com
# 2. Settings → API Keys → Create an API key → COINBASE_COMMERCE_API_KEY
# 3. Settings → Webhook subscriptions → add endpoint at /api/billing/crypto-webhook
#    Subscribe to: charge:confirmed, charge:resolved
#    Copy the shared secret into COINBASE_COMMERCE_WEBHOOK_SECRET
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# Direct USDC payments on Base (EIP-3009 transferWithAuthorization)
# Customers sign a gasless authorization; our relayer wallet submits the tx and
# pays the (sub-cent) gas. No KYC, no platform fees.
# 1. MERCHANT_USDC_ADDRESS — the Base wallet that should receive USDC
# 2. RELAYER_PRIVATE_KEY  — a SEPARATE Base wallet's private key, funded with a
#                           few dollars of ETH on Base. Used only to pay gas.
# 3. BASE_RPC_URL         — optional override; defaults to https://mainnet.base.org
MERCHANT_USDC_ADDRESS=
RELAYER_PRIVATE_KEY=
BASE_RPC_URL=
