# Auth — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=

# Google OAuth — create at console.cloud.google.com → APIs & Services → Credentials
# Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
GROQ_API_KEY=gsk_...
GROQ_API_KEYS=           # comma-separated for multi-key rotation
GROQ_MODEL=llama-3.3-70b-versatile

# Notifications
RESEND_API_KEY=re_...
RESEND_FROM=noreply@yourdomain.com

# Database (leave blank to use ./data/automations.db locally)
DATABASE_PATH=

# Vercel / Turso (production only)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Worker
CHROME_HEADLESS=false
CHROME_STEALTH=true
